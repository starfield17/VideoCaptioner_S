<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Captioner.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#172033" />
    <SolidColorBrush x:Key="MutedBrush" Color="#68758B" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3568D4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9C89" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EC" />
    <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF0FC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C94B5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="#F8FAFD" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="#C9D3E2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TextBox.field:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="#C9D3E2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="NumericUpDown.field">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="#C9D3E2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#2D5DBF" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="#C9D3E2" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{StaticResource SoftBlueBrush}" />
      <Setter Property="BorderBrush" Value="#AFC1E2" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#EEF2F8" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource SoftBlueBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFF5F6" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="#F0C8D0" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="TabControl.workbench">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.workbench TabItem">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="15,9" />
    </Style>
    <Style Selector="ProgressBar.compact">
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Background" Value="#E4EAF3" />
    </Style>
  </Application.Styles>
</Application>
