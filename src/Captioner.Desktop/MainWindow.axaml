<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Captioner.Desktop"
        x:Class="Captioner.Desktop.MainWindow"
        x:DataType="local:MainWindow"
        Title="Captioner"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680">
  <Grid RowDefinitions="68,*">
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0">
      <Grid ColumnDefinitions="Auto,32,Auto,*,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="Bold"
                       Text="C" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Captioner" />
            <TextBlock Classes="caption" FontSize="11" Text="Batch SRT workbench" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button x:Name="NewBatchNavButton"
                  Classes="nav active"
                  Content="New batch"
                  Click="NewBatchNav_Click" />
          <Button x:Name="QueueNavButton"
                  Classes="nav"
                  Content="Queue"
                  Click="QueueNav_Click" />
        </StackPanel>

        <Border x:Name="RunStateBadge"
                Grid.Column="4"
                Background="#EAF7F4"
                CornerRadius="14"
                Padding="11,6"
                Margin="0,0,10,0"
                IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
            <TextBlock x:Name="RunStateText" FontSize="12" FontWeight="SemiBold" Foreground="#17705D" Text="Batch running" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5">
          <Button x:Name="StopButton"
                  Classes="ghost"
                  Content="Stop"
                  Click="Stop_Click"
                  IsVisible="False" />
          <Button x:Name="SettingsButton"
                  Classes="secondary"
                  Content="Settings"
                  Click="Settings_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <local:NewBatchView x:Name="NewBatchPage" />
      <local:QueueView x:Name="QueuePage" IsVisible="False" />
    </Grid>
  </Grid>
</Window>
