<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Captioner"
    Manufacturer="starfield17"
    Version="$(var.Version)"
    UpgradeCode="A4CF39E5-5F37-5C24-A3B6-DB4724132378"
    Scope="perUser"
    Language="1033"
    InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Captioner is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Files Include="$(var.SourceDir)\**" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Captioner">
        <Component Id="ApplicationShortcut" Guid="64C878D9-EA6C-52B0-A328-C8B58BF05F27">
          <Shortcut
            Id="StartMenuShortcut"
            Name="Captioner"
            Description="Batch media-to-SRT captioning"
            Target="[INSTALLFOLDER]captioner-desktop.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\starfield17\Captioner" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/starfield17/VideoCaptioner_S" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/starfield17/VideoCaptioner_S/releases" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />
  </Package>
</Wix>
